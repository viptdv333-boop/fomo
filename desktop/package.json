{
  "name": "fomo-desktop",
  "productName": "FOMO",
  "version": "1.0.0",
  "description": "FOMO for Windows and macOS: a thin desktop shell around https://fomo.spot (flavor terminal: https://terminal.fomo.spot)",
  "author": "FOMO <support@fomo.spot>",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:terminal": "node -e \"process.env.FOMO_FLAVOR='terminal';require('child_process').spawnSync(require('electron'),['.'],{stdio:'inherit',env:process.env})\"",
    "smoke": "electron . --smoke",
    "dist": "node build/dist.js main --win nsis --x64",
    "dist:terminal": "node build/dist.js terminal --win nsis --x64",
    "dist:mac": "node build/dist.js main --mac",
    "dist:mac:terminal": "node build/dist.js terminal --mac"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
