# Database - Railway provides this automatically when you add PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-32-char-string"
NEXTAUTH_URL="https://your-app.railway.app"

# Port - Railway sets this automatically
PORT=3000

# Bot publishing (POST /api/bot/ideas) — сервер-к-серверу, для внешних торговых
# терминалов. Bearer-токен, идея всегда бесплатная, автор фиксирован (Михаил).
FOMO_BOT_TOKEN=""

# Cloudflare Turnstile — protects registration from bulk sign-ups.
# Both keys come from dash.cloudflare.com -> Turnstile -> your widget.
# Leave unset locally: the widget and the server check both no-op, so the form
# still works, guarded only by the rate limits.
CAPTCHA_SECRET=

# Web Push — generate once with `npx web-push generate-vapid-keys` and never
# rotate casually: rotating invalidates every subscription already stored in
# PushSubscription, silently breaking push for everyone until they re-subscribe.
# Leave unset locally: push subscribe/send both no-op without them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@fomo.spot"

# MOEX ALGOPACK (Promo subscription: online candles / trades / order books, SuperCandles, FUTOI, Mega Alerts, HI2).
# The key is personal: set it ONLY on the server (/opt/fomo/.env), never commit it. Without it everything behaves as before.
# By default the data is served to site admins only (ADMIN / OWNER); other visitors keep the delayed public ISS feed.
# ALGOPACK_KEY=
# Opt-in: serve the ALGOPACK data to every visitor (your own licensing decision; leave unset to keep it admin-only).
# ALGOPACK_PUBLIC=1
# Visitors WITHOUT a session get delayed MOEX data only (public ISS candles ~15 min late, ISS quotes, no T-Invest tail / ALGOPACK
# panels), whatever ALGOPACK_PUBLIC says. Opt-in to restore the old behaviour (real time for guests too; your licensing decision):
# GUEST_REALTIME=1
# Smoke test on the server: set -a; . ./.env; set +a; npx tsx scripts/check-algopack.ts

# FOREX (terminal tab «Форекс», source=forex; src/lib/forex.ts). Candles: FMP (FMP_API_KEY, official) -> Stooq -> Yahoo Finance (UNOFFICIAL
# keyless fallback, no contract / SLA). Quotes: Yahoo first, FMP second (FMP free plan = 250 calls a day, a polled watchlist would spend it).
# Paid FMP plan: FOREX_QUOTE_PROVIDERS=fmp,yahoo. Any comma list of fmp | stooq | yahoo is accepted.
# FOREX_QUOTE_PROVIDERS=yahoo,fmp
# FOREX_CANDLE_PROVIDERS=fmp,stooq,yahoo
# FMP calls the forex layer may spend per UTC day (the calendar shares the key), quote cache in ms, FMP intraday wall-clock zone:
# FOREX_FMP_DAILY_MAX=150
# FOREX_QUOTE_TTL_MS=8000
# FOREX_FMP_TZ=America/New_York
# Smoke test on the server: NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt npx tsx scripts/check-forex.ts --env /opt/fomo/.env

# ---------------------------------------------------------------------------
# Notification channels (Профиль -> Уведомления). Full setup: docs/notifications.md
# A channel whose variables are missing shows "не настроено администратором" in the UI.
# Secrets live ONLY in /opt/fomo/.env on the server, never in git.
# ---------------------------------------------------------------------------

# E-mail uses the same Resend account as the sign-up codes (src/lib/email.ts).
# RESEND_API_KEY=
# EMAIL_FROM="FOMO <no-reply@fomo.spot>"

# Telegram — the SITE bot (create in @BotFather). Users connect via https://t.me/<username>?start=<token>.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=fomo_notify_bot        # without @
# Any random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token and the webhook route checks it.
# TELEGRAM_WEBHOOK_SECRET=
# api.telegram.org is blocked from the RU host: relay / proxy (shared with the legacy "own bot" flow).
# TELEGRAM_API_BASE=https://your-relay.example.workers.dev
# TELEGRAM_RELAY_SECRET=
# TELEGRAM_PROXY=http://127.0.0.1:10809

# MAX messenger bot (dev.max.ru). Deep link: https://max.ru/<username>?start=<token>
# MAX_BOT_TOKEN=
# MAX_BOT_USERNAME=
# MAX_WEBHOOK_SECRET=                          # sent back by MAX in X-Max-Bot-Api-Secret
# MAX_API_BASE=https://platform-api.max.ru

# WhatsApp Cloud API (Meta) — official API only, template messages. See docs/notifications.md for the templates.
# WHATSAPP_TOKEN=                              # permanent system-user token
# WHATSAPP_PHONE_ID=                           # phone number ID (not the number itself)
# WHATSAPP_TEMPLATE_CODE=fomo_code             # authentication template, 1 body parameter (the code)
# WHATSAPP_TEMPLATE_NOTIFY=fomo_notify         # utility template, 3 body parameters: title, text, link
# WHATSAPP_API_VERSION=v21.0

# VKontakte community messages (Callback API). Deep link: https://vk.me/<community>?ref=<token>
# VK_GROUP_TOKEN=                              # community access token with "messages" right
# VK_COMMUNITY_NAME=                           # screen name, e.g. fomo_spot
# VK_CALLBACK_SECRET=                          # "secret key" of the Callback API server
# VK_CONFIRMATION_CODE=                        # string VK shows when you add the Callback API server
# VK_API_VERSION=5.199

# Public site URL used by scripts/notify-setup-webhooks.ts when registering the bot webhooks.
# NOTIFY_PUBLIC_URL=https://fomo.spot
# Reminder "subscription ends in 3 days" (a notification the site never sent before) — off unless set to 1.
# SUBSCRIPTION_EXPIRY_NOTICE=1
