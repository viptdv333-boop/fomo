# Database - Railway provides this automatically when you add PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-32-char-string"
NEXTAUTH_URL="https://your-app.railway.app"

# Port - Railway sets this automatically
PORT=3000

# Bot publishing (POST /api/bot/ideas) — сервер-к-серверу, для внешних торговых
# терминалов. Bearer-токен, идея всегда бесплатная, автор фиксирован (Михаил).
FOMO_BOT_TOKEN=""

# Yandex SmartCaptcha — protects registration from bulk sign-ups.
# Both keys come from Yandex Cloud -> SmartCaptcha -> your captcha.
# Leave unset locally: the widget and the server check both no-op, so the form
# still works, guarded only by the rate limits.
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
