<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fomo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/fomo_bg</item>
        <item name="colorPrimary">@color/fomo_green</item>
        <item name="colorAccent">@color/fomo_green</item>
    </style>

    <!-- Splash (androidx.core:core-splashscreen): brand colour + wordmark, then the activity switches to Theme.Fomo. -->
    <style name="Theme.Fomo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fomo_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Fomo</item>
    </style>
</resources>
