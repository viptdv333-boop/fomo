<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificate authorities only (user-installed CAs are NOT trusted, in debug builds too). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
